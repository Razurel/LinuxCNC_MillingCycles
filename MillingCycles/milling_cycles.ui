  <!-- ===================================================== -->
  <!-- HAUPTFENSTER                                          -->
  <!-- ===================================================== -->

  <object class="GtkWindow" id="window1">

    <property name="visible">True</property>
    <property name="title">Milling Cycles</property>
    <property name="default_width">500</property>
    <property name="default_height">600</property>

    <child>

      <object class="GtkNotebook" id="notebook">

        <property name="visible">True</property>


        <!-- ================================================= -->
        <!-- RUNDLOCH                                           -->
        <!-- ================================================= -->

        <child>

          <object class="GtkBox" id="circle_box">

            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <property name="margin">20</property>
            <property name="halign">center</property>

            <child>
              <object class="GtkLabel" id="circle_title">
                <property name="visible">True</property>
                <property name="label">RUNDLOCH FRÄSEN</property>
                <property name="xalign">0.5</property>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="circle_diameter_box">
                <property name="visible">True</property>
                <property name="spacing">8</property>

                <child>
                  <object class="GtkLabel" id="circle_diameter_label">
                    <property name="visible">True</property>
                    <property name="label">Lochdurchmesser:</property>
                    <property name="width_chars">20</property>
                    <property name="xalign">0</property>
                  </object>
                </child>

                <child>
                  <object class="GtkSpinButton" id="circle_diameter">
                    <property name="visible">True</property>
                    <property name="width_chars">10</property>
                    <property name="numeric">True</property>
                    <property name="digits">3</property>
                    <property name="adjustment">circle_diameter_adjustment</property>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="circle_diameter_unit">
                    <property name="visible">True</property>
                    <property name="label">mm</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="circle_depth_box">
                <property name="visible">True</property>
                <property name="spacing">8</property>

                <child>
                  <object class="GtkLabel" id="circle_depth_label">
                    <property name="visible">True</property>
                    <property name="label">Lochtiefe:</property>
                    <property name="width_chars">20</property>
                    <property name="xalign">0</property>
                  </object>
                </child>

                <child>
                  <object class="GtkSpinButton" id="circle_depth">
                    <property name="visible">True</property>
                    <property name="width_chars">10</property>
                    <property name="numeric">True</property>
                    <property name="digits">3</property>
                    <property name="adjustment">circle_depth_adjustment</property>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="circle_depth_unit">
                    <property name="visible">True</property>
                    <property name="label">mm</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="circle_cutter_box">
                <property name="visible">True</property>
                <property name="spacing">8</property>

                <child>
                  <object class="GtkLabel" id="circle_cutter_label">
                    <property name="visible">True</property>
                    <property name="label">Fräserdurchmesser:</property>
                    <property name="width_chars">20</property>
                    <property name="xalign">0</property>
                  </object>
                </child>

                <child>
                  <object class="GtkSpinButton" id="circle_cutter_diameter">
                    <property name="visible">True</property>
                    <property name="width_chars">10</property>
                    <property name="numeric">True</property>
                    <property name="digits">3</property>
                    <property name="adjustment">circle_cutter_diameter_adjustment</property>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="circle_cutter_unit">
                    <property name="visible">True</property>
                    <property name="label">mm</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="circle_pitch_box">
                <property name="visible">True</property>
                <property name="spacing">8</property>

                <child>
                  <object class="GtkLabel" id="circle_pitch_label">
                    <property name="visible">True</property>

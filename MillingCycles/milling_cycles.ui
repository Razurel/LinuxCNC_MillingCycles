                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="circle_feed_approach_box">
                <property name="visible">True</property>
                <property name="spacing">8</property>

                <child>
                  <object class="GtkLabel" id="circle_feed_approach_label">
                    <property name="visible">True</property>
                    <property name="label">Zustell-Feed (Z):</property>
                    <property name="width_chars">20</property>
                    <property name="xalign">0</property>
                  </object>
                </child>

                <child>
                  <object class="GtkSpinButton" id="circle_feed_approach">
                    <property name="visible">True</property>
                    <property name="width_chars">10</property>
                    <property name="numeric">True</property>
                    <property name="digits">1</property>
                    <property name="adjustment">circle_feed_approach_adjustment</property>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="circle_feed_approach_unit">
                    <property name="visible">True</property>
                    <property name="label">mm/min</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="circle_feed_mill_box">
                <property name="visible">True</property>
                <property name="spacing">8</property>

                <child>
                  <object class="GtkLabel" id="circle_feed_mill_label">
                    <property name="visible">True</property>
                    <property name="label">Schnitt-Feed (XYZ):</property>
                    <property name="width_chars">20</property>
                    <property name="xalign">0</property>
                  </object>
                </child>

                <child>
                  <object class="GtkSpinButton" id="circle_feed_mill">
                    <property name="visible">True</property>
                    <property name="width_chars">10</property>
                    <property name="numeric">True</property>
                    <property name="digits">1</property>
                    <property name="adjustment">circle_feed_mill_adjustment</property>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="circle_feed_mill_unit">
                    <property name="visible">True</property>
                    <property name="label">mm/min</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkLabel" id="circle_spacer">
                <property name="visible">True</property>
                <property name="label"> </property>
              </object>
            </child>

            <child>
              <object class="GtkButton" id="circle_preview">
                <property name="visible">True</property>
                <property name="label">VORSCHAU AKTUALISIEREN</property>
              </object>
            </child>

            <child>
              <object class="GtkLabel" id="circle_info">
                <property name="visible">True</property>
                <property name="label">Vorschau prüfen und mit AXIS PLAY starten.</property>
              </object>
            </child>

          </object>

        </child>

        <child type="tab">
          <object class="GtkLabel" id="circle_tab">
            <property name="visible">True</property>
            <property name="label">Rundloch</property>
          </object>
        </child>


        <!-- ================================================= -->
        <!-- RECHTECK                                           -->
        <!-- ================================================= -->


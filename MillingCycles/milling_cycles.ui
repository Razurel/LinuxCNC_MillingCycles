                <child>
                  <object class="GtkLabel" id="surface_milling_depth_label">
                    <property name="visible">True</property>
                    <property name="label">Frästiefe:</property>
                    <property name="width_chars">20</property>
                    <property name="xalign">0</property>
                  </object>
                </child>

                <child>
                  <object class="GtkSpinButton" id="surface_milling_depth">
                    <property name="visible">True</property>
                    <property name="width_chars">10</property>
                    <property name="numeric">True</property>
                    <property name="digits">3</property>
                    <property name="adjustment">surface_milling_depth_adjustment</property>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="surface_milling_depth_unit">
                    <property name="visible">True</property>
                    <property name="label">mm</property>
                  </object>
                </child>

              </object>
            </child>

            <child>
              <object class="GtkBox" id="surface_start_z_box">
                <property name="visible">True</property>
                <property name="spacing">8</property>

                <child>
                  <object class="GtkLabel" id="surface_start_z_label">
                    <property name="visible">True</property>
                    <property name="label">Start Z über Werkstück:</property>
                    <property name="width_chars">20</property>
                    <property name="xalign">0</property>
                  </object>
                </child>

                <child>
                  <object class="GtkSpinButton" id="surface_start_z">
                    <property name="visible">True</property>
                    <property name="width_chars">10</property>
                    <property name="numeric">True</property>
                    <property name="digits">1</property>
                    <property name="adjustment">surface_start_z_adjustment</property>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="surface_start_z_unit">
                    <property name="visible">True</property>
                    <property name="label">mm</property>
                  </object>
                </child>

              </object>
            </child>

            <child>
              <object class="GtkBox" id="surface_overlap_box">
                <property name="visible">True</property>
                <property name="spacing">8</property>

                <child>
                  <object class="GtkLabel" id="surface_overlap_label">
                    <property name="visible">True</property>
                    <property name="label">Überlappung:</property>
                    <property name="width_chars">20</property>
                    <property name="xalign">0</property>
                  </object>
                </child>

                <child>
                  <object class="GtkSpinButton" id="surface_overlap">
                    <property name="visible">True</property>
                    <property name="width_chars">10</property>
                    <property name="numeric">True</property>
                    <property name="digits">2</property>
                    <property name="adjustment">surface_overlap_adjustment</property>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="surface_overlap_unit">
                    <property name="visible">True</property>
                    <property name="label">%</property>
                  </object>
                </child>

              </object>
            </child>

            <child>
              <object class="GtkLabel" id="surface_startpoint_title">
                <property name="visible">True</property>
                <property name="label">STARTPUNKT</property>
                <property name="xalign">0</property>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="surface_startpoint_box">
                <property name="visible">True</property>
                <property name="orientation">horizontal</property>
                <property name="spacing">20</property>

                <child>
                  <object class="GtkRadioButton" id="surface_start_left_top">
                    <property name="visible">True</property>
                    <property name="label">Links Oben</property>
                    <property name="active">True</property>
                  </object>
                </child>

                <child>
                  <object class="GtkRadioButton" id="surface_start_right_top">
                    <property name="visible">True</property>
                    <property name="label">Rechts Oben</property>
                    <property name="group">surface_start_left_top</property>
                  </object>
                </child>

                <child>
                  <object class="GtkRadioButton" id="surface_start_left_bottom">
                    <property name="visible">True</property>
                    <property name="label">Links Unten</property>
                    <property name="group">surface_start_left_top</property>
                  </object>
                </child>

                <child>
                  <object class="GtkRadioButton" id="surface_start_right_bottom">
                    <property name="visible">True</property>
                    <property name="label">Rechts Unten</property>
                    <property name="group">surface_start_left_top</property>
                  </object>
                </child>

              </object>
            </child>

            <child>
              <object class="GtkBox" id="surface_feed_approach_box">
                <property name="visible">True</property>
                <property name="spacing">8</property>

                <child>
                  <object class="GtkLabel" id="surface_feed_approach_label">
                    <property name="visible">True</property>
                    <property name="label">Zustell-Feed (Z):</property>
                    <property name="width_chars">20</property>
                    <property name="xalign">0</property>
                  </object>
                </child>

                <child>
                  <object class="GtkSpinButton" id="surface_feed_approach">
                    <property name="visible">True</property>
                    <property name="width_chars">10</property>
                    <property name="numeric">True</property>
                    <property name="digits">1</property>
                    <property name="adjustment">surface_feed_approach_adjustment</property>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="surface_feed_approach_unit">
                    <property name="visible">True</property>
                    <property name="label">mm/min</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="surface_feed_mill_box">
                <property name="visible">True</property>
                <property name="spacing">8</property>

                <child>
                  <object class="GtkLabel" id="surface_feed_mill_label">
                    <property name="visible">True</property>
                    <property name="label">Schnitt-Feed (XY):</property>
                    <property name="width_chars">20</property>
                    <property name="xalign">0</property>
                  </object>
                </child>

                <child>
                  <object class="GtkSpinButton" id="surface_feed_mill">
                    <property name="visible">True</property>
                    <property name="width_chars">10</property>
                    <property name="numeric">True</property>
                    <property name="digits">1</property>
                    <property name="adjustment">surface_feed_mill_adjustment</property>
                  </object>
                </child>

                <child>
                  <object class="GtkLabel" id="surface_feed_mill_unit">
                    <property name="visible">True</property>
                    <property name="label">mm/min</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkLabel" id="surface_spacer">
                <property name="visible">True</property>
                <property name="label"> </property>
              </object>
            </child>

            <child>
              <object class="GtkButton" id="surface_preview">
                <property name="visible">True</property>
                <property name="label">VORSCHAU AKTUALISIEREN</property>
              </object>
            </child>

          </object>

        </child>

        <child type="tab">
          <object class="GtkLabel" id="surface_tab">
            <property name="visible">True</property>
            <property name="label">Oberfläche</property>
          </object>
        </child>

      </object>

    </child>

  </object>

</interface>
